          "editorMode": "code",
          "legendFormat": "__auto",
          "expr": "label_replace(max by (container_id, container_name, container_image_name) (container_memory_usage_total_bytes), \"short_id\", \"$1\", \"container_id\", \"(.{12}).*\")"
