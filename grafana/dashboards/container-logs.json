            "type": "victoriametrics-logs-datasource",
            "uid": "PD775F2863313E6C7"
          },
          "expr": "container_id:~\"${container:pipe}\" log.iostream:~\"${stream:pipe}\" ${search} | stats count() as lines",
          "queryType": "stats"
        }
