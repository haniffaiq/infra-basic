      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "PD775F2863313E6C7"
          },
          "expr": "container_id:~\"${container:pipe}\" log.iostream:~\"${stream:pipe}\" ${search} | stats count() as total, count() if (_msg:~\"(?i)error|exception|fatal|panic\") as errors | math (errors/total)*100 as pct | fields pct",
