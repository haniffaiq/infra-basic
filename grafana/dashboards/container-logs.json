{
  "uid": "container-logs",
  "title": "Container Logs",
  "description": "Container log volume, errors and live streams from VictoriaLogs. Filters at the top apply to every panel.",
  "tags": [
    "logs",
    "containers",
    "observability"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "description": "Pick containers by name. The value used in queries is the short id, which is what log records carry.",
        "datasource": {
          "type": "prometheus",
          "uid": "P4169E866C3094E38"
        },
        "definition": "query_result(max by (container_id, container_name) (container_memory_usage_total_bytes))",
        "query": {
          "qryType": 3,
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "query": "query_result(max by (container_id, container_name) (container_memory_usage_total_bytes))"
        },
        "regex": "/container_id=\"(?<value>[0-9a-f]{12})[^\"]*\".*?container_name=\"(?<text>[^\"]+)\"/",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "stream",
        "label": "Stream",
        "type": "custom",
        "description": "stdout, stderr, or both.",
        "query": "stdout,stderr",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "stdout",
            "value": "stdout"
          },
          {
            "selected": false,
            "text": "stderr",
            "value": "stderr"
          }
        ]
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "description": "Free LogsQL text appended to every query. A bare word matches that word; use _msg:~\"re\" for a regex. Leave empty for no extra filter.",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
