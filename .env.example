# Copy this file to .env and fill in strong secrets before `docker compose up -d`.
# Generate secrets with: openssl rand -base64 24

# ── PostgreSQL ───────────────────────────────────────────────
# Superuser password (used by backup + admin only).
POSTGRES_PASSWORD=

# Per-app database passwords.
PETAG_DB_PASSWORD=
JBC_DB_PASSWORD=
PHOTOBOXTYB_DB_PASSWORD=
POSTYB_DB_PASSWORD=
OSVYN_DB_PASSWORD=

# ── Redis ────────────────────────────────────────────────────
# Default (admin) user password — used by backup + admin only.
REDIS_PASSWORD=

# Per-app Redis ACL user passwords.
PETAG_REDIS_PASSWORD=
JBC_REDIS_PASSWORD=
PHOTOBOXTYB_REDIS_PASSWORD=
POSTYB_REDIS_PASSWORD=
OSVYN_REDIS_PASSWORD=

# ── MinIO ────────────────────────────────────────────────────
# Root credentials (used by provisioner + backup + admin only).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Per-app access keys (min 3 chars) and secret keys (min 8 chars).
PETAG_MINIO_ACCESS_KEY=
PETAG_MINIO_SECRET_KEY=
JBC_MINIO_ACCESS_KEY=
JBC_MINIO_SECRET_KEY=
PHOTOBOXTYB_MINIO_ACCESS_KEY=
PHOTOBOXTYB_MINIO_SECRET_KEY=
POSTYB_MINIO_ACCESS_KEY=
POSTYB_MINIO_SECRET_KEY=
OSVYN_MINIO_ACCESS_KEY=
OSVYN_MINIO_SECRET_KEY=

# ── Backup ───────────────────────────────────────────────────
# Backups older than this many days are deleted.
BACKUP_RETENTION_DAYS=7

# Optional backup connectivity overrides. Defaults use compose service DNS.
# On Podman hosts where aardvark DNS is unreliable from the backup container,
# set these to explicit verified endpoints (for example host.containers.internal
# with ports bound on 127.0.0.1 by this compose stack).
BACKUP_APPS="petag jbc photoboxtyb postyb osvyn"
BACKUP_POSTGRES_HOST=postgres
BACKUP_POSTGRES_PORT=5432
BACKUP_REDIS_HOST=redis
BACKUP_REDIS_PORT=6379
BACKUP_MINIO_ENDPOINT=http://minio:9000

# ── Observability ────────────────────────────────────────────
# Password for the read-only PostgreSQL role the collector uses.
OTEL_PG_PASSWORD=
# Login password for the `admin` user of the new Grafana.
GRAFANA_ADMIN_PASSWORD=
# Password for the database Grafana stores its own state in.
GRAFANA_DB_PASSWORD=

# Port bound on 127.0.0.1 for Grafana. 3001 is taken by petag-prod-portal,
# so the deployed stack uses 3300.
GRAFANA_PORT=3300
# Public URL Grafana is served from — the subdomain whose nginx server
# block proxies to 127.0.0.1:${GRAFANA_PORT}. nginx is managed outside
# this repo.
GRAFANA_ROOT_URL=https://grafana.example.com

# Hostname reported as host.name on all telemetry. Without it the collector
# detects its own container id, since resourcedetection runs inside it.
OTEL_HOST_NAME=infra-vps

# Where the collector writes metrics. Point this at an existing Prometheus
# instead, and stop the victoriametrics service, if you have one.
METRICS_REMOTE_WRITE_URL=http://victoriametrics:8428/api/v1/write
# Where the collector ships container and application logs.
LOGS_OTLP_ENDPOINT=http://victorialogs:9428/insert/opentelemetry/v1/logs

# How long metrics are kept before VictoriaMetrics drops them.
METRICS_RETENTION=30d
# How long logs are kept before VictoriaLogs drops them.
LOGS_RETENTION=14d
# Hard disk ceiling for logs. Log volume under zero-touch collection cannot
# be predicted, and this is what stops logs filling the disk.
LOGS_MAX_DISK=10GB
